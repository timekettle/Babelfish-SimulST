+// Qwen3-Omni / Qwen3-ASR audio encoder: tokens produced by n mel frames (100-frame chunks, 13 tokens per full
+// chunk; a partial last chunk gives fewer tokens, padding positions are dropped as in the reference)
+int clip_qwen3a_valid_tokens(int n_frames) {
+    const int full = n_frames / 100;
+    const int rem  = n_frames % 100;
+    int out = full * 13;
+    if (rem > 0) {
+        const int f1 = (rem - 1) / 2 + 1;
+        const int f2 = (f1 - 1) / 2 + 1;
+        out += (f2 - 1) / 2 + 1;
+    }
+    return out;
+}
